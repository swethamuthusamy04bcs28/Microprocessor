
                OUTPUT 2500AD
.ORG 2000H
DATA SEGMENT
STRING DB "HELLO"
CHARACTER DB "L"
RESULT DB 00H
COUNT EQU 05H
DATA ENDS
CODE SEGMENT
        ASSUME CS:CODE,DS:DATA,ES:DATA
        MOV AX,DATA
        MOV DS,AX
        MOV ES,AX
        LEA DI,STRING
        MOV AL,CHARACTER
        MOV CL,COUNT
        CLD
L2:     SCASB
        JNZ L1
        MOV RESULT,01H
        JMP L3
L1:     MOV RESULT,00H
        INC DI
        DEC CL
        JNZ L2
L3:     HLT
CODE ENDS
END
